# macOS Finder metadata
.DS_Store

# build outputs (harness objects + exes, bench snapshots, out/amalg, fuzz build)
out/
# render mismatch dumps (verify_diffs/ from -verify-render)
verify_diffs/
*.lib
*.exp
*.pdb
# reference tools are rebuilt from DjVuLibre by build.ts
ref_build/
# upstream reference checkouts (cloned by cmd/get-deps.ts); also deps/emsdk
deps/
# verifier failure list (written by cmd/tests.ts)
failures.txt
# default output of cmd/gen-oversize-mark.ts (crafted regression input)
/oversize-mark.djvu
# scratch render/text outputs
*.pnm
*.pgm
*.ppm
*.pbm
*.ilk
/terminals
# fuzzing: corpus + per-job logs are generated/large (cmd/fuzz.ts).
# fuzz/crashes/ is NOT ignored: its artifacts are tracked as regression seeds.
fuzz/corpus/
fuzz/corpus.min/
fuzz/*.log
fuzz/corpus.old/
fuzz/afl/
# libFuzzer artifacts from a manual run in the repo root (fuzz.ts writes to
# fuzz/crashes/<target>/, which IS tracked)
/crash-*
/slow-unit-*
/timeout-*
/oom-*
/leak-*
