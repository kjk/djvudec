# libFuzzer dictionary for the doc target (whole .djvu files).
# IFF magic, FORM types and every chunk id the decoder looks at.
magic="AT&T"
form="FORM"
form_djvu="FORMDJVU"
form_djvm="FORMDJVM"
form_djvi="FORMDJVI"
form_thum="FORMTHUM"
form_pm44="FORMPM44"
form_bm44="FORMBM44"
t_djvu="DJVU"
t_djvm="DJVM"
t_djvi="DJVI"
t_pm44="PM44"
t_bm44="BM44"
c_dirm="DIRM"
c_navm="NAVM"
c_info="INFO"
c_incl="INCL"
c_sjbz="Sjbz"
c_djbz="Djbz"
c_bg44="BG44"
c_fg44="FG44"
c_fgbz="FGbz"
c_txtz="TXTz"
c_txta="TXTa"
c_antz="ANTz"
c_anta="ANTa"
c_th44="TH44"
c_cida="CIDa"
c_smmr="Smmr"
c_bgjp="BGjp"
c_fgjp="FGjp"
# INFO rotation flags 1/6/2/5, version 24/0, dpi 300/600 (LE)
info_tail_rot0="\x18\x00\x2c\x01\x16\x01"
info_tail_rot90="\x18\x00\x2c\x01\x16\x06"
info_tail_rot180="\x18\x00\x58\x02\x16\x02"
info_tail_rot270="\x18\x00\x58\x02\x16\x05"
# DIRM: bundled flag + version
dirm_bundled="\x81"
dirm_indirect="\x01"
# sizes that stress the size fields
u32_max="\xff\xff\xff\xff"
u32_big="\x7f\xff\xff\xff"
u32_zero="\x00\x00\x00\x00"
u16_max="\xff\xff"
