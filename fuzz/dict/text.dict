# libFuzzer dictionary for the text target (TXTa payload: u24 length, UTF-8,
# version byte, zone tree of [type u8][5 x biased s16][u24 text len][u24 kids]).
version="\x01"
z_page="\x01"
z_column="\x02"
z_region="\x03"
z_para="\x04"
z_line="\x05"
z_word="\x06"
z_char="\x07"
s16_bias="\x80\x00"
s16_min="\x00\x00"
s16_max="\xff\xff"
u24_zero="\x00\x00\x00"
u24_one="\x00\x00\x01"
u24_max="\xff\xff\xff"
utf8_2="\xc3\xa9"
utf8_3="\xe2\x82\xac"
utf8_4="\xf0\x9f\x98\x80"
utf8_bad="\xc3"
